{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Extension Fixer",
  "version": "0.1.0",
  "identifier": "com.fileextensionfixer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "File Extension Fixer",
        "width": 960,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mschuepbach",
    "copyright": "Copyright © 2026 mschuepbach",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Fix media files with the wrong extension",
    "homepage": "https://github.com/mschuepbach/file-extension-fixer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
